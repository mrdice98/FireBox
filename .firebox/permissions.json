{
  "safety_level": "BALANCED",
  "workspace_only": true,
  "allow_shell_commands": false,
  "allow_file_deletions": false,
  "allow_git_push": false,
  "allow_env_modifications": false,
  "blocked_commands": [
    "rmdir /s /q c:\\",
    "format",
    "del /f /s /q c:\\",
    "rm -rf /",
    "mkfs",
    "dd if=",
    ":(){ :|:& };:"
  ],
  "whitelisted_commands": [
    "git status",
    "git diff",
    "git log",
    "npm test",
    "pytest",
    "cargo test",
    "python -m pytest",
    "npm run build",
    "go test"
  ]
}